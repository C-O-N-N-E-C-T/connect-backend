{
  "name": "connect-backend",
  "version": "0.1.0",
  "description": "CONNECT — Offline-first earthquake search-and-rescue backend API & Supabase Auth integration (Epic E10)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/scripts/seed.ts",
    "check:env": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "supabase": "^3.2.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "~5.9",
    "vitest": "^3.0.7"
  }
}
