# ============================================================================
# CONNECT Backend — Environment Variables Template (.env.example)
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# SECURITY WARNING:
# - NEVER commit `.env` to Git (this repository is PUBLIC).
# - NEVER expose `SUPABASE_SERVICE_ROLE_KEY` in `connect-web` or `connect-mobile`.
# ============================================================================

# Server Configuration
NODE_ENV=development
PORT=3000

# CORS Configuration (React Coordination & Admin Dashboard Origin)
CORS_ORIGIN=http://localhost:5173

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL Connection (for migrations / admin scripts if needed)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Initial Seed Accounts (OSP-59 — Passwords must be >=10 chars with lower, upper, digits & symbols)
SEED_ADMIN_EMAIL=admin@connect.internal
SEED_ADMIN_PASSWORD=ChangeMe!1234
SEED_ADMIN_FULL_NAME=System Administrator

SEED_COORDINATOR_EMAIL=coordinator@connect.internal
SEED_COORDINATOR_PASSWORD=ChangeMe!1234
SEED_COORDINATOR_FULL_NAME=Disaster Coordinator

SEED_RESCUER_EMAIL=rescuer@connect.internal
SEED_RESCUER_PASSWORD=ChangeMe!1234
SEED_RESCUER_FULL_NAME=Field Rescuer
